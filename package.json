{
  "name": "webhook-delivery-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r run --if-present typecheck",
    "dev:bench": "COMPOSE_PROFILES=bench CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://webhooks:webhooks@localhost:6433/webhooks pnpm dev",
    "monitoring": "docker compose --profile monitoring up -d prometheus grafana",
    "dev": "docker compose up -d --wait && wrangler dev -c apps/api/wrangler.toml -c apps/dispatcher/wrangler.toml -c apps/delivery/wrangler.toml -c apps/creator/wrangler.toml -c apps/limiter/wrangler.toml --test-scheduled",
    "seed:workspace": "pnpm --filter @wds/scripts seed:workspace",
    "dashboard": "pnpm --filter @wds/dashboard dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r run --if-present test",
    "migrate": "pnpm --filter @wds/db migrate",
    "seed": "pnpm --filter @wds/db seed",
    "consumer": "wrangler dev -c apps/test-consumer/wrangler.toml",
    "smoke": "pnpm --filter @wds/scripts smoke",
    "chaos": "pnpm --filter @wds/scripts chaos",
    "invariant": "pnpm --filter @wds/scripts invariant",
    "bench:matching": "pnpm --filter @wds/scripts bench:matching",
    "bench:dispatch": "pnpm --filter @wds/scripts bench:dispatch",
    "bench:fairness": "pnpm --filter @wds/scripts bench:fairness",
    "bench:backlog": "pnpm --filter @wds/scripts bench:backlog",
    "bench:bloat": "pnpm --filter @wds/scripts bench:bloat",
    "deploy:cloud": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
